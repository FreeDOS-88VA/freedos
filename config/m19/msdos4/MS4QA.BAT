@ECHO OFF
SET TESTVAR=OK
ECHO %TESTVAR% > ENV.TXT
CALL SUBQA
COMMAND /Y /C ECHO SWITCHOK > SWITCH.TXT
COMMAND /C ECHO CHILDOK > CHILD.TXT
IF ERRORLEVEL 1 GOTO FAILED
JWASMR -0 -bin -Fo=HELLO.COM HELLO.ASM > ASMCOM.TXT
IF ERRORLEVEL 1 GOTO FAILED
IF NOT EXIST HELLO.COM GOTO FAILED
HELLO.COM > RUNCOM.TXT
IF ERRORLEVEL 1 GOTO FAILED
JWASMR -0 -mz -Fo=MZDEMO.EXE MZDEMO.ASM > ASMMZ.TXT
IF ERRORLEVEL 1 GOTO FAILED
IF NOT EXIST MZDEMO.EXE GOTO FAILED
MZDEMO.EXE > RUNMZ.TXT
IF ERRORLEVEL 1 GOTO FAILED
ECHO BATCHOK > BATCH.TXT
GOTO DONE
:FAILED
ECHO FAILED > BATCH.TXT
:DONE
