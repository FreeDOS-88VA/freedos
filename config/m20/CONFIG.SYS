REM Loader placement is read before the kernel configuration passes.
REM 1000h keeps 256 KiB support; 1340h needs more than 256 KiB of RAM.
PC88VA_LOADSEG=1000
REM Four 1024-byte cache buffers; headers are additional.
BUFFERS=4
FILES=16
LASTDRIVE=E
SET PATH=A:\
DOS=LOW
REM Shell menu: a digit selects, Enter or 5 seconds takes 1, F5 skips and F8 traces.
MENUDEFAULT=1,5
MENU Select the command shell:
MENU   1 = FreeCOM 0.86 (swaps itself out while a program runs)
MENU   2 = MS-DOS 4.0 COMMAND.COM
MENU
REM KSSF swaps FreeCOM out (/SWAP makes it the default; CALL /S forces it).
1?SHELL=A:\KSSF.COM A:\COMMAND.COM /E:512 /P /SWAP
REM MS-DOS 4 COMMAND sets COMSPEC from its directory argument.
2?SHELL=A:\MSDOS\COMMAND.COM A:\MSDOS\ /E:512 /P
